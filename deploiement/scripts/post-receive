#!/bin/bash
# Hook de deploiement, installe dans le dossier hooks/ du depot nu de chaque
# instance : /opt/online-emulators.git pour l'instance par defaut,
# /opt/online-emulators-<nom>.git pour une instance nommee.
#
# Le serveur n'a aucun acces a la forge : on pousse depuis son poste vers ce
# depot nu, et le hook met a jour l'arbre de travail. Rien a configurer cote
# forge, aucune cle de deploiement a confier au serveur.
#
#     git remote add serveur ssh://mon-serveur/opt/online-emulators.git
#     git push serveur main
#
# Tourne sous l'utilisateur qui pousse, pas en root : seul le redemarrage du
# service et les migrations passent par sudo, via la regle deposee dans
# /etc/sudoers.d/.
set -uo pipefail

# Un seul fichier pour toutes les instances, sans aucun chemin en dur : le hook
# deduit son instance du depot nu dans lequel il est installe, et tout le reste
# du nom de ce depot. C'est la convention posee par installation.sh. A faire
# avant tout `cd` : git lance le hook par un chemin qui peut etre relatif.
DEPOT="$(CDPATH='' cd -- "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)" || exit 1
NOM="$(basename "$DEPOT" .git)"
case "$NOM" in
    online-emulators)
        UTILISATEUR="jeux"
        ETIQUETTE="" ;;
    online-emulators-?*)
        UTILISATEUR="jeux-${NOM#online-emulators-}"
        ETIQUETTE=", instance ${NOM#online-emulators-}" ;;
    *)
        NOM="" ;;
esac
# Lance depuis l'arbre de travail plutot que depuis sa copie dans hooks/, ou
# depuis un depot renomme a la main, le hook ne sait pas qui il sert : mieux
# vaut s'arreter que deployer au mauvais endroit.
if [ -z "$NOM" ] || [ "$DEPOT" = "${DEPOT%.git}" ]; then
    echo "ERREUR : $DEPOT n'est pas le depot nu d'une instance" >&2
    echo "(attendu : /opt/online-emulators.git ou /opt/online-emulators-<nom>.git)." >&2
    exit 1
fi
ARBRE="${DEPOT%.git}"
ENV_FILE="/etc/$NOM.env"
BRANCHE="main"

echo
echo "--- Deploiement d'Online Emulators$ETIQUETTE ---"

# Les hooks heritent de GIT_DIR : sans le vider, les commandes git suivantes
# viseraient le depot nu au lieu de l'arbre de travail.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_QUARANTINE_PATH

branche_poussee=non
while read -r _ancien _nouveau ref; do
    [ "$ref" = "refs/heads/$BRANCHE" ] && branche_poussee=oui
done

if [ "$branche_poussee" != oui ]; then
    echo "Rien a faire : la branche $BRANCHE n'est pas concernee."
    exit 0
fi

echo "Mise a jour de $ARBRE..."
git --git-dir="$DEPOT" --work-tree="$ARBRE" checkout -f "$BRANCHE" || exit 1
git --git-dir="$DEPOT" --work-tree="$ARBRE" log --oneline -1

cd "$ARBRE" || exit 1

# L'environnement sert a drizzle-kit et a la validation de configuration que
# `next build` declenche en important les pages.
if [ ! -r "$ENV_FILE" ]; then
    echo "ERREUR : $ENV_FILE illisible." >&2
    exit 1
fi
set -a
# shellcheck disable=SC1090
. "$ENV_FILE"
set +a

echo "Dependances..."
# `npm ci` et pas `npm install` : la version installee est exactement celle du
# fichier de verrouillage teste en local.
#
# --include=dev est indispensable : le fichier d'environnement charge juste
# au-dessus pose NODE_ENV=production, et npm saute alors les dependances de
# developpement. Or la construction en a besoin — TypeScript, Tailwind — et les
# migrations aussi, drizzle-kit en etant une.
npm ci --include=dev --no-audit --no-fund || exit 1

echo "Migrations..."
# Sous l'identite du service, via un script dedie : le dossier de donnees
# n'est ecrivable que par l'utilisateur du service, et SQLite a besoin d'ecrire
# dans le dossier lui-meme pour y creer app.db-wal et app.db-shm. Voir
# migrer.sh.
# La commande doit correspondre mot pour mot a la regle sudoers ecrite par
# installation.sh : meme utilisateur, meme chemin absolu, aucun argument de
# plus. Sinon sudo -n refuse, faute de pouvoir demander un mot de passe.
sudo -n -u "$UTILISATEUR" "$ARBRE/deploiement/scripts/migrer.sh" || exit 1

echo "Coeur d'emulation..."
# mGBA n'est pas versionne : il est copie depuis node_modules vers public/.
# Sans cette etape, le lecteur se chargerait sur un dossier vide.
npm run core:install || exit 1

echo "Construction..."
npm run build || exit 1

# Le service tourne sous son propre utilisateur, qui doit lire .next ; le
# cache doit exister avant le demarrage, ProtectSystem=strict ne le creerait
# pas.
mkdir -p .next/cache
chgrp -R "$UTILISATEUR" .next 2>/dev/null || true
chmod -R g+rX .next

echo "Redemarrage du service..."
# Meme contrainte que pour les migrations : la regle sudoers n'autorise que
# `systemctl restart` suivi du nom exact de l'unite de cette instance.
sudo -n systemctl restart "$NOM" || exit 1
sleep 2
# Sans sudo : lire l'etat d'une unite ne demande aucun privilege. Avec sudo, il
# faudrait que les arguments correspondent au mot pres a la regle sudoers, et
# un simple --quiet suffisait a la faire manquer — le service redemarrait bien,
# mais le hook annoncait un echec.
if systemctl is-active --quiet "$NOM"; then
    echo "--- En ligne : ${PUBLIC_URL:-adresse publique non renseignee} ---"
else
    echo "ERREUR : le service n'a pas demarre." >&2
    echo "Diagnostic : sudo journalctl -u $NOM -n 40" >&2
    exit 1
fi
