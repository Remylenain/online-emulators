# ---------------------------------------------------------------------------
# Copier en `.env` et renseigner. Aucune de ces valeurs ne doit être commitée.
# ---------------------------------------------------------------------------

# Base de données SQLite : chemin du fichier, créé au premier démarrage.
DATABASE_PATH="./data/app.db"

# URL publique du site, sans slash final. Sert aux liens dans les e-mails
# et à la validation des cookies. Jamais écrite en dur dans le code.
PUBLIC_URL="http://localhost:3000"

# Secret de signature des sessions et des jetons.
# Générer avec : openssl rand -base64 48
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Stockage sur disque (hors dépôt). Chemins absolus en production.
# ---------------------------------------------------------------------------

# Bibliothèque de jeux : un dossier par console, un dossier par jeu.
LIBRARY_DIR="./library"

# Données générées : sauvegardes, savestates, avatars, miniatures.
DATA_DIR="./data"

# ---------------------------------------------------------------------------
# Envoi d'e-mails (réinitialisation de mot de passe)
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Online Emulators <noreply@example.com>"

# ---------------------------------------------------------------------------
# Captcha Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# Laisser vide en développement : le captcha est alors contourné.
# ---------------------------------------------------------------------------
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Activité Discord (facultative) : un jeu du site jouable dans Discord.
# https://discord.com/developers/applications → ton application
# Les Activités se déclarent dans l'administration (onglet Discord), une par
# jeu, chacune sur son nom d'hôte. Ce bloc est le repli : une seule Activité,
# qui répond sur l'hôte du site. Laisser vide pour ne pas l'activer.
# Voir docs/discord/README.md.
# ---------------------------------------------------------------------------
# « Application ID », onglet General Information.
DISCORD_CLIENT_ID=""
# « Client Secret », onglet OAuth2. Ne jamais le commiter ni le partager.
DISCORD_CLIENT_SECRET=""
# Identifiant du jeu servi dans l'Activité, tel qu'en base (ex. "gbc-mon-jeu").
DISCORD_JEU=""
# Verrou facultatif : l'identifiant du seul serveur Discord où l'Activité
# accepte d'être jouée (clic droit sur le serveur → Copier l'identifiant, mode
# développeur activé). Laisser vide pour l'accepter partout.
DISCORD_SERVEUR=""
# « Token », onglet Bot. Exigé par le verrou : c'est avec lui que le site
# demande à Discord où l'Activité tourne. Ne jamais le commiter ni le partager.
DISCORD_BOT_TOKEN=""
# Facultatif, avec le verrou : les identifiants des rôles du serveur qui
# donnent le droit de jouer, séparés par des virgules (clic droit sur un rôle →
# Copier l'identifiant). Le bot doit alors être invité dans le serveur. Laisser
# vide pour accepter tous les membres du serveur.
DISCORD_ROLES=""
# Facultatif : « Public Key », onglet General Information. Avec elle, le site
# répond aux interactions de Discord, pour qu'une commande tapée dans un salon
# lance l'Activité (voir docs/discord/README.md, « La commande de lancement »).
# Publique : rien de secret. Inutile pour une application déclarée dans
# l'administration.
DISCORD_CLE_PUBLIQUE=""
# "1" pour ouvrir /discord hors de Discord pendant le développement.
# Ignoré en production.
DISCORD_ESSAI_LOCAL=""
